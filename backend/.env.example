# =====================================================================
#  Konfiguracja panelu administratora warsztatu.
#  Skopiuj ten plik jako `.env` i uzupelnij wartosci.
#
#  UWAGA (ryzyko A2): plik `.env` NIGDY nie trafia do repozytorium ani do
#  aplikacji mobilnej. Klucz service_role omija wszystkie zabezpieczenia
#  bazy - kto go ma, ma cala baze klientow.
# =====================================================================

# Adres projektu Supabase (Settings -> Data API -> Project URL)
SUPABASE_URL=https://tpigqlvwjatlkhfqtlkt.supabase.co

# Klucz service_role (Settings -> API Keys -> service_role, "Reveal").
# TYLKO tutaj. Nigdy w aplikacji mobilnej, nigdy w gicie.
SUPABASE_SERVICE_ROLE_KEY=

# Haslo do panelu administratora. Wymysl dlugie, wpisuje sie je rzadko.
HASLO_PANELU=

# Podpis administratora w dzienniku dzialan (kto komu przyznal dostep)
NAZWA_ADMINISTRATORA=administrator

# Port panelu
PORT=4000

# 127.0.0.1 = panel widoczny WYLACZNIE z tego komputera. Nie zmieniaj -
# za panelem stoi klucz service_role.
HOST=127.0.0.1

# Katalog na kopie zapasowe robione poleceniem `npm run kopia`.
# Domyslnie <katalog-projektu>/kopie
# KATALOG_KOPII=D:\kopie-warsztat
