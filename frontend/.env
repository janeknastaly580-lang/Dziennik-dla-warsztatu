# =====================================================================
#  KLUCZE PUBLICZNE APLIKACJI MOBILNEJ
#
#  Ten plik JEST w repozytorium - i tak ma byc.
#
#  Wszystko, co ma prefiks EXPO_PUBLIC_, Expo wkleja na stale do paczki
#  .apk / .ipa przy budowaniu. Paczke da sie rozpakowac w kilka minut,
#  wiec te wartosci sa publiczne z definicji - nie ma sensu ich ukrywac
#  i nie ma sensu udawac, ze sa sekretem.
#
#  Bezpieczenstwo NIE opiera sie tutaj na tajnosci klucza, tylko na tym,
#  ze ten klucz nie daje dostepu do niczego:
#    - kazda tabela ma RLS bez zadnej polityki,
#    - role anon i authenticated nie maja wstepu do schematu public,
#    - dane wydaje wylacznie funkcja brzegowa po sprawdzeniu tokenu
#      urzadzenia, ktory administrator moze uniewaznic.
#  Sprawdzenie: powershell -File ..\supabase\testy\test-anon.ps1
#
#  CZEGO TU NIGDY NIE MOZE BYC:
#    SUPABASE_SERVICE_ROLE_KEY, sb_secret_..., haslo do bazy, klucze API
#    jakiejkolwiek platnej uslugi. Ich miejsce to narzedzia/.env oraz
#    sekrety Edge Functions. app.config.js przerywa build, jesli wykryje
#    tu klucz z rola service_role.
# =====================================================================

EXPO_PUBLIC_SUPABASE_URL=https://tpigqlvwjatlkhfqtlkt.supabase.co

# Klucz publishable (nowy format, rotowalny niezaleznie) - uzywany, gdy jest.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_pcwvkAD9XVEG9sDT0RGScQ_6p5UTZwt

