{
  "expo": {
    "name": "Warsztat",
    "slug": "warsztat",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "warsztat",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "//extra": [
      "A2: w aplikacji moze byc WYLACZNIE klucz publiczny (anon).",
      "Klucz service_role omija RLS - jego miejsce jest w Edge Functions",
      "i w backend/.env, nigdy tutaj. Paczke .apk / .ipa kazdy rozpakuje."
    ],
    "extra": {
      "supabaseUrl": "https://tpigqlvwjatlkhfqtlkt.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRwaWdxbHZ3amF0bGtoZnF0bGt0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMjE0MTMsImV4cCI6MjEwMzU5NzQxM30.EzdtM7UGsdyIlKuAX7JMY12jrxGuVWy6OOmRajn1MxY"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pl.warsztat.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "pl.warsztat.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Odcisk palca lub Face ID sluzy do odblokowania aplikacji warsztatu."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D4ED8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "./plugins/prywatnosc.js"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "//web": "Aplikacja nie ma wersji webowej. W przegladarce nie istnieje Keychain/Keystore (expo-secure-store), wiec token urzadzenia i haslo nie mialyby gdzie bezpiecznie lezec, a expo-sqlite wymaga tam osobnego modulu WASM. Cel to APK/IPA."
  }
}
