# =====================================================================
#  KLUCZE SEKRETNE - WYLACZNIE NA KOMPUTERZE DOSTAWCY USLUGI
#
#  Skopiuj ten plik jako `.env` i uzupelnij. Plik `.env` jest w .gitignore
#  i NIGDY nie trafia do repozytorium ani do paczki aplikacji.
#
#  PODZIAL KLUCZY W TYM PROJEKCIE (ryzyko A2):
#
#    frontend/.env      EXPO_PUBLIC_SUPABASE_URL
#                       EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#                       EXPO_PUBLIC_SUPABASE_ANON_KEY
#      -> publiczne z definicji, Expo wkleja je do .apk/.ipa,
#         plik JEST w repozytorium, bo ukrywanie ich niczego nie chroni
#
#    narzedzia/.env     SUPABASE_SERVICE_ROLE_KEY        <- TEN PLIK
#      -> omija RLS i cale bezpieczenstwo bazy; kto go ma, ma baze klientow
#
#    sekrety Supabase   SUPABASE_SERVICE_ROLE_KEY dla Edge Functions
#      -> ustawiane w panelu Supabase, wstrzykiwane automatycznie
#
#  Zaden z kluczy z TEGO pliku nie ma prawa pojawic sie w katalogu frontend/.
#  Pilnuja tego dwie rzeczy: `npm run skanuj` (hook pre-commit) oraz
#  app.config.js, ktory przerywa build aplikacji.
# =====================================================================

# Adres projektu Supabase (Settings -> Data API -> Project URL)
SUPABASE_URL=https://tpigqlvwjatlkhfqtlkt.supabase.co

# Klucz service_role (Settings -> API Keys -> service_role -> Reveal).
# TYLKO tutaj. Nigdy w aplikacji, nigdy w gicie, nigdy w wiadomosci.
SUPABASE_SERVICE_ROLE_KEY=

# Podpis w dzienniku dzialan (kto wystawil zaproszenie dla warsztatu)
NAZWA_DOSTAWCY=dostawca

# Katalog na kopie zapasowe robione poleceniem `npm run kopia`.
# Domyslnie <katalog-projektu>/kopie
# KATALOG_KOPII=D:\kopie-warsztat
